OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
# Optional: use Anthropic instead of OpenAI. Set ANTHROPIC_API_KEY (and,
# optionally, ANTHROPIC_MODEL) and it's picked automatically; set
# LLM_PROVIDER=openai|anthropic to force one when both keys are present.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-5
LLM_PROVIDER=

# Optional: for real web search
SERPER_API_KEY=your_serper_api_key_here
# Optional: enables real sandboxed Python execution via E2B (https://e2b.dev)
# Without it, execute_python returns a safe stub.
E2B_API_KEY=your_e2b_api_key_here

# Optional: per-IP rate limit on task creation. Defaults to 10 tasks / 10 min.
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=600000

# Optional: pause after planning and require an explicit approve/reject
# before any execution step or tool call runs. Off by default.
REQUIRE_PLAN_APPROVAL=false

# Optional: enable the durable Redis-backed queue/worker (see worker.ts and
# docker-compose.yml's `durable` profile). Unset = direct in-process runs.
REDIS_URL=
